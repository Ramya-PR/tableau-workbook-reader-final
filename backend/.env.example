# Copy to backend/.env and fill in what you need. Never commit .env.

# --- Tableau Public (no account needed to read public workbooks) ---
# Your profile name, as it appears in your profile URL. Used to list your workbooks.
TABLEAU_PUBLIC_PROFILE=your.profile.name

# --- Tableau Server / Tableau Cloud (optional) ---
# Leave blank to disable. Create a personal access token in your account settings.
TABLEAU_SERVER_URL=
TABLEAU_SITE=
TABLEAU_PAT_NAME=
TABLEAU_PAT_SECRET=

# --- Limits (defaults shown) ---
# MAX_FILE_MB=500
# MAX_UNCOMPRESSED_MB=2048
# SESSION_TTL_MINUTES=30
# DEFAULT_PREVIEW_ROWS=100
# MAX_PREVIEW_ROWS=1000

# --- Other ---
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# PUBLIC_ALLOWED_HOSTS=public.tableau.com
# PUBLIC_DOWNLOAD_URL_TEMPLATE=
# PUBLIC_LIST_URL_TEMPLATE=
